# Select the LLM provider: mock, openai, anthropic, or gemini
LLM_PROVIDER=gemini

# Model used for refactoring experiments
LLM_MODEL=gemini-3.5-flash-lite

# Add your own API key to your local .env file
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: configure other providers when needed
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
